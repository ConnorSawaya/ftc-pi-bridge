#!/bin/bash
# ftc-bridge: control the Pi bridge from the terminal (for you or an AI agent).
#
#   ftc-bridge status               which robot the Pi is on, and whether its hub answers
#   ftc-bridge robots               saved robots (name, Wi-Fi name)
#   ftc-bridge scan                 nearby Wi-Fi networks
#   ftc-bridge add NAME WIFI_NAME   save a robot; the password is read from stdin (asked if typing)
#   ftc-bridge use NAME             switch the Pi to that robot
#   ftc-bridge forget NAME          delete a saved robot
#   ftc-bridge disconnect           take the Pi off the robot's Wi-Fi (before a match: rule R704.C)
#   ftc-bridge reboot | shutdown    restart or shut down the Pi (shut down before unplugging)
#   ftc-bridge health               Wi-Fi signal and channel, robot app, adb, and whether it's the same hub as before
#   ftc-bridge speedtest            real upload speed to the robot (sends 8 MB through adb, then deletes it)
#   ftc-bridge key                  this computer's public key (to give to whoever set up the Pi)
#   ftc-bridge add-key "KEY"        let another computer (e.g. a teammate's Windows PC) use the Pi
#   ftc-bridge pi-log [N]           how the Pi's previous run ended (a freeze ends without a shutdown), and
#                                   how often the USB link to this Mac went dead and was re-plugged
#   ftc-bridge pi-version           the Pi's software version, and the one on this Mac
#   ftc-bridge update-pi            update the Pi's software from this Mac (takes a few seconds)
#
#   Run these from the robot project folder:
#   ftc-bridge upload [NAME]        send code to the robot. Uses Sloth hot reload (~1 s) if the
#                                   project has it, otherwise a full install. NAME switches robot first.
#   ftc-bridge upload --full [NAME] full install + app restart (needed after changing libraries
#                                   or Gradle files, or code outside the teamcode package).
#                                   Backs up the robot first.
#   ftc-bridge test                 run the TeamCode unit tests on this Mac (no robot needed)
#
#   ftc-bridge logs [--errors] [--since-mark] [N]
#                                   last N lines (default 300) of the robot's log; --since-mark: everything
#                                   since the last upload or `mark`
#   ftc-bridge search PATTERN [N]   lines matching PATTERN (regex, any case) in the last N lines, with context
#   ftc-bridge crashes [N]          crashes and exceptions in the last N log lines (default 3000)
#   ftc-bridge mark TEXT            write a marker line into the recorded log (e.g. "starting intake test")
#   ftc-bridge record               keep recording the robot's log on this Mac (the app runs this), so the
#                                   log commands above read it instantly
#   ftc-bridge data                 runs recorded on the robot by BridgeLog (robot/BridgeLog.java)
#   ftc-bridge data pull [latest|all|NAME]   copy runs to this Mac (only new ones); prints their paths
#   ftc-bridge data summary [latest|FILE]    each column's min / max / mean, and how long the run was
#   ftc-bridge backup               save the robot's configs and app to this Mac (newest 5 kept per robot)
#   ftc-bridge backups              list backups
#   ftc-bridge restore ROBOT/TIME [--force]   put a backup's app and configs back on the robot
#   ftc-bridge panels [--stop]      open the robot's Panels dashboard on this Mac (http://localhost:8001)
#   ftc-bridge tuning [--stop]      open Pedro Pathing's AutoTune page on this Mac (http://localhost:10158): the
#                                   Foresight, Mecanum and Pinpoint tuners (the robot drives itself: give it room)
#   ftc-bridge adb ARGS...          any adb command against the robot, e.g. adb push x /sdcard/FIRST/
#
# Example for an agent:  printf '%s\n' 'the-password' | ftc-bridge add comp 12345-RC
set -euo pipefail

# Where this script really lives (it may be run through a symlink), and the Pi's files next to it.
SELF="$0"; while [[ -L "$SELF" ]]; do SELF="$(readlink "$SELF")"; done
PI_FILES="$(cd "$(dirname "$SELF")" && pwd)/pi"
PI="ftc@10.12.194.1"
SSH_OPTS=(-i "$HOME/.ssh/ftcpi" -o BatchMode=yes -o ConnectTimeout=3 -o LogLevel=ERROR
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
ADB_SERIAL="10.12.194.1:5555"
RC_ACTIVITY="com.qualcomm.ftcrobotcontroller/org.firstinspires.ftc.robotcontroller.internal.PermissionValidatorWrapper"
ADB="$(command -v adb || echo "$HOME/Library/Android/sdk/platform-tools/adb")"
STUDIO_JAVA="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
# Panels: 8001 web page, 8002 live data (the page connects to <its own host>:8002);
# 5800/5801/5805/5807: the Limelight, which the Panels Limelight plugin passes through the hub.
PANELS_PORTS="8001 8002 5800 5801 5805 5807"
TUNING_PORTS="10158 12649"   # Pedro Pathing AutoTune: its page, and the WebSocket the page opens on the same host
APP="com.qualcomm.ftcrobotcontroller"
BACKUPS="$HOME/Library/Application Support/ftc-pi-bridge/backups"
KEEP_BACKUPS=5
DATA="$HOME/Library/Application Support/ftc-pi-bridge/data"   # runs pulled from the robot
ROBOT_DATA="/sdcard/FIRST/bridge-data"                        # where BridgeLog.java writes them
# What the FTC SDK and Android log when robot code throws, freezes or crashes the app.
CRASH_PATTERN='User code threw an uncaught exception|User OpMode was stuck in|FATAL EXCEPTION'
LOG_DIR="$HOME/Library/Logs/ftc-bridge"
ROBOT_LOG="$LOG_DIR/robot.log"           # the recorder appends here; rotated to robot.log.1 at 20 MB
RECORDER_PID="$LOG_DIR/recorder.pid"

die() { echo "error: $*" >&2; exit 1; }
check_name() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "robot names can use letters, numbers, . _ - (up to 32)"; }

# Run ftc-hub on the Pi. The Pi gets a new host key every reflash and sits on a direct
# USB cable, so its key isn't pinned.
pi() {
  local rc=0
  ssh "${SSH_OPTS[@]}" "$PI" sudo /usr/local/bin/ftc-hub "$@" || rc=$?
  [[ $rc -eq 255 ]] && die "can't reach the Pi. Is it plugged into this Mac?"
  return $rc
}

field() { sed -n "s/^$1=//p"; }

# The Pi software's version: a fingerprint of the files in pi/, so any change makes a new one.
latest_pi_version() { (cd "$PI_FILES" && cat $(ls | sort) | shasum -a 256 | cut -c1-12); }
installed_pi_version() {
  ssh "${SSH_OPTS[@]}" "$PI" 'cat /etc/ftc-pi-bridge/version 2>/dev/null || echo none' ||
    die "can't reach the Pi. Is it plugged into this Mac?"
}

status() {
  local s robot ssid hub
  s="$(pi status)"
  robot="$(field robot <<<"$s")"; ssid="$(field ssid <<<"$s")"; hub="$(field hub <<<"$s")"
  if [[ -z "$robot" ]]; then echo "Pi plugged in, no robot chosen (ftc-bridge use NAME)"; return 1
  elif [[ "$hub" == up ]]; then echo "Connected to $robot ($ssid), hub reachable"
  else echo "Set to $robot ($ssid), but the hub isn't answering. Is the robot on?"; return 1
  fi
}

# Make sure adb is talking to the robot through the Pi, and only to it.
connect_adb() {
  status >&2
  "$ADB" disconnect "$ADB_SERIAL" >/dev/null 2>&1 || true  # drop any connection to a previous robot
  "$ADB" connect "$ADB_SERIAL" | grep -q 'connected to' || die "adb couldn't connect through the Pi"
  export ANDROID_SERIAL="$ADB_SERIAL"  # Gradle and plain `adb` now only target the robot
}

# For commands that only read: reuse adb's connection if it's up (fast), else connect.
quick_adb() {
  if [[ "$("$ADB" -s "$ADB_SERIAL" get-state 2>/dev/null)" == device ]]; then export ANDROID_SERIAL="$ADB_SERIAL"
  else connect_adb >/dev/null; fi
}

recording() { [[ -f "$RECORDER_PID" ]] && kill -0 "$(cat "$RECORDER_PID")" 2>/dev/null; }

# The robot's last $1 log lines: from the recorded log while the recorder runs (instant),
# otherwise straight from the robot.
recent_log() {
  if recording && [[ -s "$ROBOT_LOG" ]]; then tail -n "$1" "$ROBOT_LOG"
  else quick_adb; "$ADB" logcat -d -v threadtime -t "$1" | tr -d '\r'; fi
}

# A marker line in the recorded log, so `logs --since-mark` can start from it.
mark_log() {
  mkdir -p "$LOG_DIR"
  printf '=== ftc-bridge: %s (%s) ===\n' "$1" "$(date '+%m-%d %H:%M:%S')" >> "$ROBOT_LOG"
}

gradle() {
  [[ -x ./gradlew ]] || die "run this from your robot project folder (the one with gradlew)"
  # Gradle needs a JDK; Android Studio ships one, and this Mac may have no other.
  if [[ -z "${JAVA_HOME:-}" ]] && ! /usr/libexec/java_home >/dev/null 2>&1; then export JAVA_HOME="$STUDIO_JAVA"; fi
  ./gradlew "$@"
}

hub_serial() { "$ADB" shell getprop ro.serialno 2>/dev/null | tr -d '\r'; }

# Saves the robot's configs and app to BACKUPS/<robot>/<time>/, keeping the newest KEEP_BACKUPS.
backup_robot() {
  local robot dir apk configs
  robot="$(field robot <<<"$(pi status)")"; [[ -n "$robot" ]] || robot=unknown
  dir="$BACKUPS/$robot/$(date +%Y-%m-%d_%H%M%S)"
  mkdir -p "$dir/configs"
  while IFS= read -r f; do
    [[ -n "$f" ]] && { "$ADB" pull "$f" "$dir/configs/" >/dev/null 2>&1 || true; }
  done < <("$ADB" shell 'ls /sdcard/FIRST/*.xml 2>/dev/null' | tr -d '\r')
  apk="$("$ADB" shell pm path "$APP" 2>/dev/null | tr -d '\r' | sed -n 's/^package://p' | head -1)"
  [[ -n "$apk" ]] && { "$ADB" pull "$apk" "$dir/robot-app.apk" >/dev/null 2>&1 || true; }
  printf 'robot=%s\nhub_serial=%s\ntime=%s\n' "$robot" "$(hub_serial)" "$(date)" > "$dir/info.txt"
  configs=$(ls "$dir/configs" | wc -l | tr -d ' ')
  echo "Backed up $robot: $configs config(s)$([[ -f "$dir/robot-app.apk" ]] && echo ' and the app') -> $robot/$(basename "$dir")"
  ls -1d "$BACKUPS/$robot"/*/ 2>/dev/null | sort -r | tail -n +$((KEEP_BACKUPS + 1)) |
    while IFS= read -r old; do rm -rf "$old"; done
}

has_sloth() { grep -qsi sloth TeamCode/build.gradle* build.gradle* build.dependencies.gradle; }

case "${1:-}" in
  status) status ;;
  robots) pi list ;;
  scan) pi scan ;;
  add)
    NAME="${2:-}"; SSID="${3:-}"
    check_name "$NAME"; [[ -n "$SSID" ]] || die "usage: ftc-bridge add NAME WIFI_NAME"
    if [[ -t 0 ]]; then read -r -s -p "Wi-Fi password for $SSID: " PSK; echo; else IFS= read -r PSK; fi
    printf '%s\n%s\n' "$SSID" "$PSK" | pi add "$NAME"
    ;;
  use)
    check_name "${2:-}"; pi use "$2"
    "$ADB" disconnect "$ADB_SERIAL" >/dev/null 2>&1 || true  # don't keep talking to the last robot
    ;;
  forget) check_name "${2:-}"; pi forget "$2" ;;
  disconnect) pi disconnect ;;
  reboot) pi power reboot ;;
  shutdown) pi power off ;;
  upload)
    FULL=""; [[ "${2:-}" == "--full" ]] && { FULL=1; shift; }
    if [[ -n "${2:-}" ]]; then check_name "$2"; pi use "$2"; fi
    [[ -x ./gradlew ]] || die "run this from your robot project folder (the one with gradlew)"
    connect_adb
    robot="$(field robot <<<"$(pi status)")"
    if [[ -z "$FULL" ]] && has_sloth; then
      mark_log "upload to $robot (Sloth)"
      # Sloth (Dairy Foundation) hot-reloads the teamcode package; it applies when the current OpMode ends.
      gradle :TeamCode:deploySloth
      echo "Uploaded with Sloth. Changes load when the current OpMode stops."
    else
      backup_robot || echo "(backup failed; installing anyway)"
      mark_log "upload to $robot (full install)"
      # Sloth's hot-loaded code survives installs and would override the new app, so clear it first.
      if has_sloth; then gradle :TeamCode:removeSlothRemote :TeamCode:installDebug; else gradle :TeamCode:installDebug; fi
      "$ADB" shell am start -n "$RC_ACTIVITY" >/dev/null
      echo "Full install done. Robot Controller app restarted."
    fi
    ;;
  test) gradle :TeamCode:testDebugUnitTest ;;
  health)
    H="$(pi health)"
    ok=1
    robot="$(field robot <<<"$H")"
    [[ -n "$robot" ]] || { echo "No robot chosen (ftc-bridge use NAME)"; exit 1; }
    echo "Robot:     $robot"
    if [[ -n "$(field signal <<<"$H")" ]]; then
      echo "Wi-Fi:     signal $(field signal <<<"$H")/100, $(field freq <<<"$H") (channel $(field channel <<<"$H")), $(field rate <<<"$H")"
    else
      echo "Wi-Fi:     not connected to the robot's Wi-Fi. Is the robot on?"; ok=0
    fi
    if [[ "$(field rc_app <<<"$H")" == up ]]; then
      echo "Robot app: running (SDK $(field sdkVersion <<<"$H"), config \"$(field activeConfigName <<<"$H")\", hub Wi-Fi $(field hubChannel <<<"$H"))"
    else
      echo "Robot app: not answering (is the Robot Controller app running?)"; ok=0
    fi
    serial="$(field serialNumber <<<"$H")"
    case "$(field same_hub <<<"$H")" in
      yes) echo "Hub:       $serial, the same hub as before" ;;
      first_time) echo "Hub:       $serial, saved as $robot's hub" ;;
      no) echo "Hub:       $serial, a DIFFERENT hub than $robot had before ($(field saved_serial <<<"$H")). Check you're on the right robot."; ok=0 ;;
    esac
    if [[ "$(field adb_port <<<"$H")" == open ]]; then
      "$ADB" disconnect "$ADB_SERIAL" >/dev/null 2>&1 || true
      if "$ADB" connect "$ADB_SERIAL" | grep -q 'connected to'; then
        adb_serial="$("$ADB" -s "$ADB_SERIAL" shell getprop ro.serialno 2>/dev/null | tr -d '\r')"
        if [[ -n "$serial" && "$adb_serial" != "$serial" ]]; then
          echo "adb:       connected, but to hub $adb_serial, not $serial"; ok=0
        else
          echo "adb:       connected${adb_serial:+ to hub $adb_serial}"
        fi
      else
        echo "adb:       the robot's adb port is open but adb couldn't connect"; ok=0
      fi
    else
      echo "adb:       not reachable (robot off, or its adb is off)"; ok=0
    fi
    [[ $ok == 1 ]] || exit 1
    ;;
  key)
    if [[ ! -f "$HOME/.ssh/ftcpi" ]]; then
      mkdir -p "$HOME/.ssh"; ssh-keygen -q -t ed25519 -N "" -C "ftcpi-$(hostname -s)" -f "$HOME/.ssh/ftcpi"
    fi
    cat "$HOME/.ssh/ftcpi.pub"
    ;;
  add-key)
    KEY="${*:2}"
    [[ "$KEY" =~ ^ssh-(ed25519|rsa)\ [A-Za-z0-9+/=]+(\ [A-Za-z0-9._@-]+)?$ ]] ||
      die "that doesn't look like a public key (it starts with ssh-ed25519). Get it with: ftc-bridge key"
    printf '%s\n' "$KEY" | ssh "${SSH_OPTS[@]}" "$PI" \
      'IFS= read -r k; grep -qxF "$k" ~/.ssh/authorized_keys 2>/dev/null && echo "That computer already has access." ||
       { printf "%s\n" "$k" >> ~/.ssh/authorized_keys; echo "Added. That computer can use the Pi now."; }' ||
      die "can't reach the Pi. Is it plugged into this Mac?"
    ;;
  pi-log)
    ssh "${SSH_OPTS[@]}" "$PI" "sudo journalctl -b -1 --no-pager -n ${2:-40} -o short 2>/dev/null |
      grep . || echo 'No earlier run saved yet.'
      sudo journalctl -b -1 --no-pager -n 3 2>/dev/null | grep -q 'Journal stopped' &&
        echo '(That run ended with a normal shutdown or restart.)' ||
        echo '(That run ended suddenly: a freeze, a power cut, or the cable was pulled.)'
      echo; sudo /usr/local/bin/ftc-hub links 2>/dev/null || true" ||
      die "can't reach the Pi. Is it plugged into this Mac?"
    ;;
  pi-version)
    installed="$(installed_pi_version)"; latest="$(latest_pi_version)"
    echo "installed=$installed"; echo "latest=$latest"
    [[ "$installed" == "$latest" ]] && echo "The Pi is up to date." || echo "Update with: ftc-bridge update-pi"
    ;;
  update-pi)
    [[ -f "$PI_FILES/install.sh" ]] || die "can't find the Pi's files ($PI_FILES)"
    latest="$(latest_pi_version)"
    # Copy pi/ over the USB link (without macOS's ._ metadata files) and run its install script
    # as root. Also set the Pi's clock: it has no internet to set it, so it drifts.
    COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -czf - -C "$PI_FILES" . | ssh "${SSH_OPTS[@]}" "$PI" \
      "sudo date -u -s @$(date +%s) >/dev/null; rm -rf /tmp/ftc-pi-update && mkdir /tmp/ftc-pi-update &&
       tar -xzf - -m --warning=no-unknown-keyword -C /tmp/ftc-pi-update &&
       sudo bash /tmp/ftc-pi-update/install.sh $latest; rc=\$?; rm -rf /tmp/ftc-pi-update; exit \$rc" ||
      die "updating the Pi failed (is it plugged in?)"
    ;;
  speedtest)
    quick_adb
    f="$(mktemp)"; head -c 8000000 /dev/urandom > "$f"  # random, so nothing can compress it
    out="$("$ADB" push "$f" /data/local/tmp/ftc-bridge-speedtest 2>&1 | tail -1)" || true
    rm -f "$f"; "$ADB" shell rm -f /data/local/tmp/ftc-bridge-speedtest >/dev/null 2>&1 || true
    speed="$(grep -oE '[0-9.]+ MB/s \([0-9]+ bytes in [0-9.]+s\)' <<<"$out")" || die "speed test failed: $out"
    echo "Upload speed: $speed"
    ;;
  crashes)
    recent_log "${2:-3000}" |
      awk -v pat="$CRASH_PATTERN" '$0 ~ pat {n = 14; found = 1; print "----"} n > 0 {print; n--}
        END {if (!found) print "No crashes in the recent log."}'
    ;;
  data)
    case "${2:-list}" in
      list)
        quick_adb
        # toybox ls -l: perms links owner group size date time name
        runs="$("$ADB" shell "ls -l $ROBOT_DATA 2>/dev/null" | tr -d '\r' | awk '$NF ~ /\.csv$/ {printf "%s  (%.0f KB)\n", $NF, $5/1024}' | sort -r)"
        [[ -n "$runs" ]] && echo "$runs" || echo "No runs on the robot yet. Add robot/BridgeLog.java to TeamCode and run an OpMode."
        ;;
      pull)
        quick_adb
        robot="$(field robot <<<"$(pi status)")"; dest="$DATA/${robot:-unknown}"; mkdir -p "$dest"
        listing="$("$ADB" shell "ls -l $ROBOT_DATA 2>/dev/null" | tr -d '\r' | awk '$NF ~ /\.csv$/ {print $5, $NF}' | sort -k2 -r)"
        [[ -n "$listing" ]] || die "no runs on the robot yet (add robot/BridgeLog.java to TeamCode and run an OpMode)"
        case "${3:-latest}" in
          latest) wanted="$(head -1 <<<"$listing")" ;;
          all) wanted="$listing" ;;
          *) wanted="$(awk -v n="$3" '$2 == n || $2 == n".csv"' <<<"$listing")"; [[ -n "$wanted" ]] || die "no run called $3 (ftc-bridge data lists them)" ;;
        esac
        while read -r size name; do
          # Already here with the same size: skip (a finished run never changes).
          if [[ "$(stat -f%z "$dest/$name" 2>/dev/null)" != "$size" ]]; then
            "$ADB" pull "$ROBOT_DATA/$name" "$dest/$name" >/dev/null || die "couldn't copy $name"
          fi
          echo "$dest/$name"
        done <<<"$wanted"
        ;;
      summary)
        f="${3:-latest}"
        if [[ "$f" == latest ]]; then f="$(ls -t "$DATA"/*/*.csv 2>/dev/null | head -1)"; [[ -n "$f" ]] || die "nothing pulled yet: ftc-bridge data pull"; fi
        [[ -f "$f" ]] || die "no file $f"
        echo "$f"
        awk -F, 'NR == 1 {for (i = 1; i <= NF; i++) name[i] = $i; cols = NF; next}
          {rows++; for (i = 1; i <= cols; i++) if ($i != "" && $i + 0 == $i) {
             v = $i + 0; if (!(i in n)) {mn[i] = v; mx[i] = v}; n[i]++; sum[i] += v
             if (v < mn[i]) mn[i] = v; if (v > mx[i]) mx[i] = v } ; last_t = $1 }
          END {printf "%d rows, %.1f s\n%-28s %12s %12s %12s\n", rows, last_t, "column", "min", "max", "mean"
               for (i = 1; i <= cols; i++) if (i in n) printf "%-28s %12.3f %12.3f %12.3f\n", name[i], mn[i], mx[i], sum[i] / n[i]}' "$f"
        ;;
      *) die "usage: ftc-bridge data [list | pull [latest|all|NAME] | summary [latest|FILE]]" ;;
    esac
    ;;
  backup)
    connect_adb >/dev/null
    backup_robot
    ;;
  backups)
    [[ -d "$BACKUPS" ]] || { echo "No backups yet."; exit 0; }
    (cd "$BACKUPS" && for d in */*/; do
      d="${d%/}"; [[ -f "$d/info.txt" ]] || continue
      echo "$d  ($(ls "$d/configs" | wc -l | tr -d ' ') configs$([[ -f "$d/robot-app.apk" ]] && echo ', app'))"
    done | sort -r)
    ;;
  restore)
    [[ -n "${2:-}" ]] || die "usage: ftc-bridge restore ROBOT/TIME [--force]   (ftc-bridge backups lists them)"
    dir="$BACKUPS/$2"
    [[ -f "$dir/info.txt" ]] || die "no backup called $2 (ftc-bridge backups lists them)"
    FORCE=""; [[ "${3:-}" == "--force" ]] && FORCE=1
    connect_adb
    want="$(field hub_serial < "$dir/info.txt")"; have="$(hub_serial)"
    [[ -z "$want" || "$want" == "$have" || -n "$FORCE" ]] ||
      die "that backup is from a different hub ($want; this one is $have). Add --force to restore it anyway."
    if [[ -f "$dir/robot-app.apk" ]]; then
      out="$("$ADB" install -r -d "$dir/robot-app.apk" 2>&1)" || true
      if grep -q INSTALL_FAILED_UPDATE_INCOMPATIBLE <<<"$out"; then
        [[ -n "$FORCE" ]] || die "the robot's app was built on another computer, so it has to be removed first. Add --force to do that (configs stay)."
        "$ADB" uninstall "$APP" >/dev/null 2>&1 || true
        out="$("$ADB" install "$dir/robot-app.apk" 2>&1)" || true
      fi
      grep -q Success <<<"$out" || die "install failed: $out"
    fi
    for f in "$dir"/configs/*.xml; do [[ -f "$f" ]] && "$ADB" push "$f" /sdcard/FIRST/ >/dev/null; done
    "$ADB" shell am start -n "$RC_ACTIVITY" >/dev/null
    echo "Restored $2."
    ;;
  logs)
    shift; ERRORS=""; SINCE=""; N=300
    while [[ $# -gt 0 ]]; do
      case "$1" in --errors) ERRORS=1 ;; --since-mark) SINCE=1 ;; *) N="$1" ;; esac; shift
    done
    if [[ -n "$SINCE" ]]; then
      [[ -s "$ROBOT_LOG" ]] || die "no recorded log yet (the app records it; or run: ftc-bridge record &)"
      out="$(awk '/^=== ftc-bridge: / {buf = ""} {buf = buf $0 "\n"} END {printf "%s", buf}' "$ROBOT_LOG")"
    else
      out="$(recent_log "$N")"
    fi
    # threadtime lines: "MM-DD hh:mm:ss.mmm  PID  TID L Tag: message"; keep E(rror) and F(atal), and markers.
    [[ -n "$ERRORS" ]] && out="$(grep -E '^[0-9-]+ [0-9:.]+ +[0-9]+ +[0-9]+ [EF] |^=== ftc-bridge' <<<"$out" || true)"
    printf '%s\n' "$out" | tail -n "$N"
    ;;
  search)
    [[ -n "${2:-}" ]] || die "usage: ftc-bridge search PATTERN [LINES]"
    matches="$(recent_log "${3:-20000}" | grep -i -E -C 2 -- "$2" || true)"
    [[ -n "$matches" ]] && printf '%s\n' "$matches" | tail -n 200 || echo "No lines match \"$2\"."
    ;;
  mark)
    [[ -n "${2:-}" ]] || die "usage: ftc-bridge mark TEXT"
    mark_log "${*:2}"; echo "Marked: ${*:2}"
    ;;
  record)
    mkdir -p "$LOG_DIR"
    if recording; then echo "Already recording (pid $(cat "$RECORDER_PID"))."; exit 0; fi
    echo $$ > "$RECORDER_PID"
    LC=""  # the running `adb logcat`
    stop_recording() { [[ -n "$LC" ]] && kill "$LC" 2>/dev/null; rm -f "$RECORDER_PID"; exit 0; }
    trap stop_recording INT TERM
    echo "Recording the robot's log to $ROBOT_LOG (Ctrl-C to stop)." >&2
    while true; do
      "$ADB" connect "$ADB_SERIAL" >/dev/null 2>&1 || true
      if [[ "$("$ADB" -s "$ADB_SERIAL" get-state 2>/dev/null)" == device ]]; then
        # Resume from the last recorded line's time, so a reconnect doesn't lose or repeat much.
        since="$(tail -1 "$ROBOT_LOG" 2>/dev/null | cut -c1-18 || true)"
        if [[ "$since" =~ ^[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}$ ]]; then FROM=(-T "$since"); else FROM=(-T 2000); fi
        "$ADB" -s "$ADB_SERIAL" logcat -v threadtime "${FROM[@]}" >> "$ROBOT_LOG" 2>/dev/null &
        LC=$!
        while kill -0 "$LC" 2>/dev/null; do
          sleep 5 & wait $!  # (waiting this way lets Ctrl-C / quit stop it right away)
          if (( $(stat -f%z "$ROBOT_LOG" 2>/dev/null || echo 0) > 20000000 )); then
            kill "$LC" 2>/dev/null || true; mv "$ROBOT_LOG" "$ROBOT_LOG.1"
          fi
        done
      fi
      sleep 3 & wait $!
    done
    ;;
  panels)
    if [[ "${2:-}" == "--stop" ]]; then
      for p in $PANELS_PORTS; do "$ADB" forward --remove "tcp:$p" >/dev/null 2>&1 || true; done
      echo "Panels tunnels closed."; exit 0
    fi
    quick_adb
    for p in $PANELS_PORTS; do
      "$ADB" forward "tcp:$p" "tcp:$p" >/dev/null || die "port $p is busy on this Mac (close whatever uses it)"
    done
    echo "Panels: http://localhost:8001"
    [[ "${2:-}" == "--no-open" ]] || open "http://localhost:8001"
    ;;
  tuning)
    if [[ "${2:-}" == "--stop" ]]; then
      for p in $TUNING_PORTS; do "$ADB" forward --remove "tcp:$p" >/dev/null 2>&1 || true; done
      echo "Tuning tunnels closed."; exit 0
    fi
    quick_adb
    for p in $TUNING_PORTS; do
      "$ADB" forward "tcp:$p" "tcp:$p" >/dev/null || die "port $p is busy on this Mac (close whatever uses it)"
    done
    echo "Pedro tuning: http://localhost:10158 (needs Pedro's tuning library in the robot's code; the robot drives itself, give it room)"
    [[ "${2:-}" == "--no-open" ]] || open "http://localhost:10158"
    ;;
  adb)
    shift
    quick_adb
    "$ADB" "$@"
    ;;
  *)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"; exit 2   # (the help: the comment on top)
    ;;
esac
